image sdcard.img {
	hdimage {
		partition-table-type = "gpt"
	}

	partition fsbl1 {
		image = "%ATFBIN%"
	}

	partition fsbl2 {
		image = "%ATFBIN%"
	}

	partition fip {
		image = "fip.bin"
	}

	partition u-boot-env {
		size = 2M
	}

	partition rootfsA {
		image = "rootfs.%ROOTFS_SUFFIX%"
		bootable = "yes"
	}

	partition rootfsB {
		image = "rootfs.%ROOTFS_SUFFIX%"
		bootable = "yes"
	}
}
