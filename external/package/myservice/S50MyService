#!/bin/sh

start() {
	printf "Starting MyService: "
	start-stop-daemon -c MyService -S -q -m -b -p /var/run/MyService.pid \
		--exec /usr/bin/MyService /etc/MyService/config
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}
stop() {
	printf "Stopping MyService: "
	start-stop-daemon -K -q -p /var/run/MyService.pid
	[ $? = 0 ] && echo "OK" || echo "FAIL"
}
restart() {
	stop
	start
}

case "$1" in
  start)
	start
	;;
  stop)
	stop
	;;
  restart|reload)
	restart
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
